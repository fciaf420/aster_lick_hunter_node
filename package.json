{
  "name": "aster_lick_hunter_node",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-env.js && node scripts/process-manager.js dev",
    "dev:direct": "node scripts/check-env.js && concurrently --kill-others --kill-others-on-fail -n \"WEB,BOT\" -c \"blue,green\" \"npm run dev:web\" \"npm run dev:bot\"",
    "dev:web": "node scripts/check-env.js && node scripts/start-next.js dev",
    "dev:bot": "tsx watch src/bot/index.ts",
    "build": "next build",
    "start": "node scripts/check-env.js && node scripts/process-manager.js start",
    "start:direct": "node scripts/check-env.js && concurrently --kill-others --kill-others-on-fail -n \"WEB,BOT\" -c \"blue,green\" \"npm run start:web\" \"npm run start:bot\"",
    "start:web": "node scripts/check-env.js && node scripts/start-next.js start",
    "start:bot": "tsx src/bot/index.ts",
    "setup": "npm install && node scripts/setup-config.js && npm run build",
    "setup:config": "node scripts/setup-config.js",
    "postinstall": "node scripts/postinstall.js && patch-package",
    "lint": "eslint",
    "bot": "tsx src/bot/index.ts",
    "bot:dev": "tsx watch src/bot/index.ts",
    "test": "tsx tests/run-all.ts && jest",
    "test:unit": "jest",
    "test:hunter": "tsx tests/core/hunter.test.ts",
    "test:position": "tsx tests/core/position-manager.test.ts",
    "test:rate": "tsx tests/core/rate-limit.test.ts",
    "test:ws": "tsx tests/core/websocket.test.ts",
    "test:errors": "tsx tests/core/error-logging.test.ts",
    "test:integration": "tsx tests/integration/trading-flow.test.ts",
    "test:watch": "tsx watch tests/**/*.test.ts",
    "optimize:ui": "node optimize-config.js",
    "lighter:signer": "node scripts/lighter-signer.js",
    "lighter:check": "tsx scripts/lighter-live-check.ts"
  },
  "dependencies": {
    "@types/sqlite3": "^5.1.0",
    "@types/uuid": "^11.0.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "^6.15.0",
    "gsap": "^3.15.0",
    "koffi": "3.3.2",
    "lucide-react": "^0.544.0",
    "next": "15.5.28",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.7.0",
    "uuid": "^13.0.2",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    }
  }
}
